{
  "name": "@shieldedpools/contracts",
  "version": "0.1.1",
  "description": "The Shielded Pool protocol contract and release artifacts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shieldedpools/shielded-pool-contract.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./contract/managed/shielded-pools/contract/index.d.ts",
      "default": "./contract/managed/shielded-pools/contract/index.js"
    },
    "./contract-info.json": "./contract/managed/shielded-pools/compiler/contract-info.json",
    "./artifacts/*": "./contract/managed/shielded-pools/*",
    "./package.json": "./package.json"
  },
  "files": [
    "contract/shielded-pools.compact",
    "contract/managed/shielded-pools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "compact compile +0.35.0 contract/shielded-pools.compact contract/managed/shielded-pools",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "deploy": "node --disable-warning=ExperimentalWarning scripts/deploy.ts",
    "prepublishOnly": "npm run build && npm test",
    "release": "npm run build && npm test && mkdir -p release && npm pack --pack-destination release"
  },
  "overrides": {
    "effect": "3.22.4"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.20.0"
  },
  "devDependencies": {
    "@midnightntwrk/ledger-v9": "1.0.0-rc.5",
    "@midnightntwrk/wallet-sdk-abstractions": "3.0.0-rc.1",
    "@midnightntwrk/wallet-sdk-dust-wallet": "5.0.0-rc.1",
    "@midnightntwrk/wallet-sdk-facade": "5.0.0-rc.1",
    "@midnightntwrk/wallet-sdk-hd": "3.1.0-rc.0",
    "@midnightntwrk/wallet-sdk-shielded": "4.0.0-rc.1",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "4.0.0-rc.1",
    "@types/node": "24.19.2",
    "rxjs": "7.8.2",
    "ws": "8.22.0"
  }
}
